{%- comment -%}
  Stap 369 (15 oktober 2026): de badge "Ranked in the Krillo Index".
  Een app-blok dat de winkelier zelf in een sectie zet (bijvoorbeeld onderaan
  de homepage of in de voettekst). De gegevens (plek, categorie, link) zet de
  Krillo-app elke dag in app.metafields.krillo.badge, alleen als de winkel
  echt genoemd wordt in een ranglijst. Staat er niets, dan toont het blok
  niets: nooit een lege of verzonnen badge.
{%- endcomment -%}
{%- assign b = app.metafields.krillo.badge.value -%}
{%- if b and b.url -%}
<a href="{{ b.url }}" target="_blank" rel="noopener"
   style="display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid {{ block.settings.rand }};border-radius:12px;background:{{ block.settings.achtergrond }};color:{{ block.settings.tekst }};text-decoration:none;font:500 14px/1.3 system-ui,-apple-system,sans-serif;">
  <span style="font-weight:700;letter-spacing:-0.02em;">KRILLO</span>
  <span>
    {%- if block.settings.toon_plek and b.rank -%}#{{ b.rank }} {{ 'of' }} {{ b.of }} {%- endif -%}
    {{ ' ' }}{{ block.settings.tekst_voor }} {{ b.category }}{% if b.country %}, {{ b.country }}{% endif %}
  </span>
</a>
{%- endif -%}
{% schema %}
{
  "name": "Krillo Index badge",
  "target": "section",
  "settings": [
    {"type": "checkbox", "id": "toon_plek", "label": "Show your rank", "default": true},
    {"type": "text", "id": "tekst_voor", "label": "Text", "default": "in the Krillo Index for"},
    {"type": "color", "id": "achtergrond", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "tekst", "label": "Text color", "default": "#0A0A0B"},
    {"type": "color", "id": "rand", "label": "Border", "default": "#E7E7E4"}
  ]
}
{% endschema %}
